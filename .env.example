APP_NAME="De'nish Cookies API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Jakarta
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

# Local Development Database: SQLite (Out-of-the-box, no setup required)
DB_CONNECTION=sqlite

# Hostinger Production Database: MySQL (Uncomment and fill with Hostinger cPanel/hPanel MySQL details)
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=u123456789_denish_cookies
# DB_USERNAME=u123456789_denish_user
# DB_PASSWORD=your_strong_mysql_password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database
CACHE_STORE=database

# Midtrans Payment Gateway Configuration
# For local development/demo testing without live keys, keep MIDTRANS_SERVER_KEY=sandbox-mock
MIDTRANS_SERVER_KEY=sandbox-mock
MIDTRANS_CLIENT_KEY=SB-Mid-client-mock
MIDTRANS_MERCHANT_ID=
MIDTRANS_IS_PRODUCTION=false
